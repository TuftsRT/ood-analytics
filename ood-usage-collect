# Keys read by the dashboard app from the same config file.
WEB_ONLY_KEYS = {"site_name", "show_top_users"}

LINE_RE = re.compile(
    r'^(?P<ip>\S+) \S+ (?P<user>\S+) \[(?P<ts>[^\]]+)\] '
    r'"(?P<method>[A-Z]+) (?P<uri>\S+)(?: [^"]*)?" (?P<status>\d{3})\b'
)
# Interactive app submission. Success is a redirect to the sessions page;
# a validation or submit error re-renders the form or returns 4xx/5xx.
BC_LAUNCH_RE = re.compile(
    r"^/pun/(?:sys|dev|usr/[^/]+)/dashboard/batch_connect/"
    r"(?P<token>(?:sys|dev|usr/[^/]+)/.+?)/session_contexts/?$"
)
OTHER_APP_RE = re.compile(r"^/pun/(?P<type>sys|dev|usr/[^/]+)/(?P<app>[^/]+)")
STATIC_RE = re.compile(
    r"(?:/assets/|/packs/|/favicon\.ico$|\.(?:js|css|map|png|jpe?g|gif|svg|ico|woff2?|ttf|eot)$)"
)
# A single number after the last quoted field (the User-Agent in combined
# format) is the response time. Two or more, as in combinedio's %I %O, are not.
TIMING_RE = re.compile(r'"\s+(\d+(?:\.\d+)?)\s*$')
TIMING_SCALE = {"%D": 1e-6, "%{us}T": 1e-6, "%{ms}T": 1e-3, "%T": 1.0, "%{s}T": 1.0}
# Upper edges, in seconds, of the response-time histogram buckets; the last
# bucket is everything slower. Percentiles are reported to bucket resolution.
LATENCY_EDGES = [0.1, 0.25, 0.5, 1, 2, 5, 10, 30]
# Apache sends users here to start their per-user web server (PUN).
PUN_START_RE = re.compile(r"^/nginx/(?:start|init)\b")
# Proxied traffic to running interactive apps includes websockets and
# long-polling, so its timings say nothing about page loads.
UNTIMED_AREAS = {"Interactive App Connections"}

MONTHS = {m: i for i, m in enumerate(
    ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
     "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"], 1)}

